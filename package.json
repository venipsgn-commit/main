{
  "name": "venips",
  "version": "1.0.0",
  "description": "VENIPS – Gestion Commerciale",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/api.test.js",
    "hash-password": "node hash-password.js",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.venips.app",
    "productName": "VENIPS",
    "copyright": "VENIPS Gestion Commerciale",
    "asar": false,
    "files": [
      "electron-main.js",
      "server.js",
      "index.html",
      "app.js",
      "styles.css",
      "sw.js",
      "manifest.json",
      "logo.svg",
      "icon.png",
      ".env",
      "api/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "extraResources": [],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VENIPS",
      "installerHeaderIcon": "icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png",
      "category": "Office"
    },
    "directories": {
      "output": "dist"
    }
  }
}
